# Editör yapılandırma dosyasını proje genelinde etkinleştir
root = true

# Tüm dosyalar için ortak biçimlendirme kuralları
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown dosyalarında satır sonu boşluklarını koru
[*.md]
trim_trailing_whitespace = false
